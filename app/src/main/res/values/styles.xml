<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The canvas is paper-white by design: opt out of the system's
         force-dark inversion so drawings look the same in dark mode. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
